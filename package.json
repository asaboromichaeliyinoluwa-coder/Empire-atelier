{
  "name": "empire-atelier",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,gray \"npm:server\" \"vite\"",
    "server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "launch": "npm run build && npm start",
    "build:server": "vite build -c vite.server.config.ts",
    "portable": "npm run build && npm run build:server && ./scripts-build-portable.sh",
    "mobile:build": "tsc -b && vite build --mode mobile && cap sync",
    "mobile:icons": "npx --yes @capacitor/assets@3.0.5 generate --ios --android --iconBackgroundColor '#321b13' --splashBackgroundColor '#321b13' --assetPath resources",
    "ios": "npm run mobile:build && cap open ios",
    "android": "npm run mobile:build && cap open android",
    "build:vercel": "node scripts-build-vercel.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@mediapipe/tasks-vision": "^1.1.1",
    "framer-motion": "^14.6.0",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
